    {
      "id": 9,
      "type": "table",
      "title": "最新報告摘要",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aqi-postgres"
      },
      "gridPos": {
        "x": 4,
        "y": 10,
        "w": 20,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aqi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT checked_at AS 檢查時間, overall_status AS 狀態, source AS 判斷來源, ai_status AS AI狀態, summary AS 摘要, report_key AS MinIO報告 FROM pipeline_health_report ORDER BY checked_at DESC LIMIT 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "最新報告的問題清單",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aqi-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aqi-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT i->>'severity' AS 嚴重度, i->>'component' AS 元件, i->>'finding' AS 問題, i->>'evidence' AS 證據, i->>'suggested_action' AS 建議 FROM (SELECT issues FROM pipeline_health_report ORDER BY checked_at DESC LIMIT 1) r, jsonb_array_elements(r.issues) AS i ORDER BY CASE i->>'severity' WHEN 'critical' THEN 0 WHEN 'warning' THEN 1 ELSE 2 END",
          "refId": "A"
        }
      ]
    },

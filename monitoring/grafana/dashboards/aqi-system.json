        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(airflow_dagrun_duration_count{dag_id=\"get_moenv_aqi_info_v2\"}[24h])) or vector(0)",
